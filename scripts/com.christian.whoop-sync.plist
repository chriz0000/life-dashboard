<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.christian.whoop-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/christianstyles/Projects/life-dashboard/scripts/whoop-push.sh</string>
    </array>

    <!-- Every 6 hours, and once at load. Runs missed during sleep coalesce. -->
    <key>StartInterval</key>
    <integer>21600</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/christianstyles/Projects/life-dashboard/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/christianstyles/Projects/life-dashboard/logs/launchd.err.log</string>
</dict>
</plist>
